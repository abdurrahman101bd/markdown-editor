<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/md_surface_variant">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_text_primary"
                android:layout_marginBottom="16dp" />
            <TextView
                android:id="@+id/text_detail_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/md_text_secondary"
                android:layout_marginBottom="16dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md_divider"
                android:layout_marginBottom="16dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_notes"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/md_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />
            <TextView
                android:id="@+id/text_detail_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/md_text_primary"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/text_detail_archived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/md_text_primary"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/text_detail_trash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/md_text_primary"
                android:layout_marginBottom="16dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md_divider"
                android:layout_marginBottom="16dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_settings"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/md_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />
            <TextView
                android:id="@+id/text_detail_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/md_text_primary"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="4dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:textSize="16sp"
                    android:textColor="@color/md_text_secondary"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/btn_import"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/restore"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_primary"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>