<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_toolbar_bg"
            android:title="@string/settings_title"
            app:titleTextColor="@color/md_text_primary"
            app:navigationIconTint="@color/md_toolbar_icon"
            app:navigationIcon="@drawable/ic_menu" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_appearance"
                    android:textColor="@color/md_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <LinearLayout
                    android:id="@+id/row_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_theme"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/text_theme_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/md_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/row_view_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_default_view"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/text_view_mode_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/md_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/md_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_behaviour"
                    android:textColor="@color/md_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Auto save note after specified idle time"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />                   
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_stepper"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/btn_autosave_minus"
                            android:layout_width="38dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stepper_button_left"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/md_background" />
                        <TextView
                            android:id="@+id/text_autosave_value"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="5s"
                            android:textColor="@color/md_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btn_autosave_plus"
                            android:layout_width="38dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stepper_button_right"
                            android:src="@drawable/ic_add"
                            app:tint="@color/md_background" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Auto remove deleted Notes permanently after"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_stepper"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/btn_autoremove_minus"
                            android:layout_width="38dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stepper_button_left"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/md_background" />
                        <TextView
                            android:id="@+id/text_autoremove_value"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="7 Days"
                            android:textColor="@color/md_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btn_autoremove_plus"
                            android:layout_width="38dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stepper_button_right"
                            android:src="@drawable/ic_add"
                            app:tint="@color/md_background" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/md_divider" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_backup_restore"
                    android:textColor="@color/md_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <LinearLayout
                    android:id="@+id/row_import_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Import Backup"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/row_export_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Export Backup"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
                
                <LinearLayout
					android:id="@+id/row_backup_now"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:orientation="vertical"
					android:paddingHorizontal="16dp"
					android:paddingVertical="14dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Backup Now"
						android:textColor="@color/md_text_primary"
						android:textSize="16sp" />
					<TextView
						android:id="@+id/text_last_backup"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Never"
						android:textColor="@color/md_text_secondary"
						android:textSize="13sp" />
				    <TextView
						android:id="@+id/text_last_backup_file"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text=""
						android:textColor="@color/md_text_hint"
						android:textSize="12sp"
						android:maxLines="1"
						android:ellipsize="middle" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/row_backup_history"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:orientation="vertical"
					android:paddingHorizontal="16dp"
					android:paddingVertical="14dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/backup_history"
						android:textColor="@color/md_text_primary"
						android:textSize="16sp" />
					<TextView
						android:id="@+id/text_backup_history_count"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text=""
						android:textColor="@color/md_text_secondary"
						android:textSize="13sp" />
				</LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Auto backup period in day"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_stepper"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/btn_autobackup_minus"
                            android:layout_width="38dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stepper_button_left"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/md_background" />
                        <TextView
                            android:id="@+id/text_autobackup_value"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="3 Days"
                            android:textColor="@color/md_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btn_autobackup_plus"
                            android:layout_width="38dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stepper_button_right"
                            android:src="@drawable/ic_add"
                            app:tint="@color/md_background" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/md_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_security"
                    android:textColor="@color/md_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <RelativeLayout
                    android:id="@+id/row_biometric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/switch_biometric"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lock app with device biometric or PIN"
                            android:textColor="@color/md_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/text_biometric_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Disabled"
                            android:textColor="@color/md_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_biometric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/row_screenshot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/switch_screenshot"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Disallow Screenshots"
                            android:textColor="@color/md_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/text_screenshot_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Disabled"
                            android:textColor="@color/md_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_screenshot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
                
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/md_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_about"
                    android:textColor="@color/md_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                    
                <LinearLayout
                    android:id="@+id/row_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Send feedback"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
                    
                <LinearLayout
                    android:id="@+id/row_documentation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Documentation"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
                    
                <LinearLayout
                    android:id="@+id/row_source_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Source code"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
                    
                <LinearLayout
                    android:id="@+id/row_libraries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Libraries"
                        android:textColor="@color/md_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
                    
                <LinearLayout
                    android:id="@+id/row_app_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <TextView
                        android:id="@+id/text_app_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/md_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/md_surface"
        app:itemHorizontalPadding="20dp"
        app:itemIconPadding="16dp"
        app:itemVerticalPadding="6dp"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
