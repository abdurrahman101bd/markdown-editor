<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:contentInsetStartWithNavigation="4dp"
        app:contentInsetEnd="0dp">       
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/edit_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_title"
                android:textColorHint="?android:attr/textColorHint"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@android:color/transparent"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:textSize="20sp"
                android:paddingStart="0dp"
                android:paddingEnd="8dp" />
            <ImageButton android:id="@+id/btn_undo" style="@style/EditorIconButton" android:src="@drawable/ic_undo" android:contentDescription="Undo" />
            <ImageButton android:id="@+id/btn_redo" style="@style/EditorIconButton" android:src="@drawable/ic_redo" android:contentDescription="Redo" />
            <ImageButton android:id="@+id/btn_view_toggle" style="@style/EditorIconButton" android:src="@drawable/ic_eye" android:contentDescription="Toggle view" />
            <ImageButton android:id="@+id/btn_overflow" style="@style/EditorIconButton" android:src="@drawable/ic_more_vert" android:contentDescription="More options" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/preview_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/md_outline"
        app:cardBackgroundColor="@color/md_surface">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none">
            <TextView
                android:id="@+id/text_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:minHeight="160dp"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
    
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/md_outline"
        app:cardBackgroundColor="@color/md_surface">        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipToPadding="false">
            <HorizontalScrollView
                android:id="@+id/icon_row_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:background="@android:color/transparent">                
                <LinearLayout
                    android:id="@+id/quick_insert_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical">
                    <ImageButton android:id="@+id/qi_bold" style="@style/EditorIconButton" android:src="@drawable/ic_bold" android:contentDescription="Bold" />
                    <ImageButton android:id="@+id/qi_italic" style="@style/EditorIconButton" android:src="@drawable/ic_italic" android:contentDescription="Italic" />
                    <ImageButton android:id="@+id/qi_heading" style="@style/EditorIconButton" android:src="@drawable/ic_heading" android:contentDescription="Heading" />
                    <ImageButton android:id="@+id/qi_link" style="@style/EditorIconButton" android:src="@drawable/ic_link" android:contentDescription="Link" />
                    <ImageButton android:id="@+id/qi_list" style="@style/EditorIconButton" android:src="@drawable/ic_list" android:contentDescription="List" />
                    <ImageButton android:id="@+id/qi_strike" style="@style/EditorIconButton" android:src="@drawable/ic_strikethrough" android:contentDescription="Strikethrough" />
                    <ImageButton android:id="@+id/qi_code" style="@style/EditorIconButton" android:src="@drawable/ic_code" android:contentDescription="Code" />
                    <ImageButton android:id="@+id/qi_quote" style="@style/EditorIconButton" android:src="@drawable/ic_quote" android:contentDescription="Quote" />
                    <ImageButton android:id="@+id/qi_hr" style="@style/EditorIconButton" android:src="@drawable/ic_hr" android:contentDescription="Horizontal rule" />
                    <ImageButton android:id="@+id/qi_image" style="@style/EditorIconButton" android:src="@drawable/ic_image" android:contentDescription="Image" />
                    <ImageButton android:id="@+id/qi_table" style="@style/EditorIconButton" android:src="@drawable/ic_table" android:contentDescription="Table" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md_divider" />
            <ScrollView
                android:id="@+id/editor_text_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:background="@android:color/transparent">                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/edit_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_editor"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textColor="?android:attr/textColorPrimary"
                        android:inputType="textMultiLine|textCapSentences"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="monospace" />
                    <View
                        android:id="@+id/divider_content_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/md_editor_card_border"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>