<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_ripple">  
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_selection_overlay" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="2.5dp"
                        android:color="@color/md_text_primary" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_surface" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/md_outline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
